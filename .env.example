# =============================================================================
# PASS — capa de datos (Supabase)
# =============================================================================
# Copia este archivo a .env.local y llena las keys.
#
# FASE 1 (ahora): cuenta personal del padre.
#   AGENCIES_DATABASE_PHASE=personal
#   NEXT_PUBLIC_AGENCIES_SUPABASE_URL=https://xxxx.supabase.co
#   AGENCIES_SUPABASE_SERVICE_ROLE_KEY=...
#   Preferible: secret copiada con el botón Copy (sb_secret_...) o la JWT
#   service_role de la pestaña Legacy API keys (eyJ...).
#   Corre supabase/migrations/001_agencies.sql en ese proyecto.
#
# FASE 2 (cuando la captura esté validada): base de Nexcar.
#   AGENCIES_DATABASE_PHASE=nexcar
#   Sustituye URL + keys por las de Nexcar. El código no cambia.
#
# Sin keys, la app guarda en data/store.json para no bloquear la captura.
# =============================================================================

AGENCIES_DATABASE_PHASE=personal

NEXT_PUBLIC_AGENCIES_SUPABASE_URL=
AGENCIES_SUPABASE_SERVICE_ROLE_KEY=

# --- Documentos analizados (type = invoice) ---
# El URL de cada ficha se cruza con esta base. En la hoja ya apunta a Nexcar:
# https://iorqdgnczgxnxbxjuibu.supabase.co/storage/v1/object/public/vehicles/prod/{vehicleId}/{fileId}.pdf
NEXT_PUBLIC_INVOICES_SUPABASE_URL=https://iorqdgnczgxnxbxjuibu.supabase.co
INVOICES_SUPABASE_SERVICE_ROLE_KEY=
INVOICES_TABLE=documents
INVOICE_TYPE_COLUMN=type
INVOICE_TYPE_VALUE=invoice
INVOICE_ID_COLUMN=id
INVOICE_URL_COLUMN=file_url
INVOICE_VEHICLE_ID_COLUMN=vehicle_id
INVOICES_STORAGE_BUCKET=vehicles
INVOICES_STORAGE_ENV=prod
